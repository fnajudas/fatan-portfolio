/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; frame-src 'none'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; media-src 'none'; worker-src 'none'; upgrade-insecure-requests

/assets/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/image/*
  Cache-Control: public, max-age=86400, must-revalidate

/assets/image/FOTO-DIRI*
  X-Robots-Tag: noindex, noarchive
  Cache-Control: private, max-age=86400, must-revalidate

/assets/cv/*
  X-Robots-Tag: noindex, noarchive, nosnippet
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=86400
